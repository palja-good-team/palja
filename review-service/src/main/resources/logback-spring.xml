<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="SERVICE_NAME" source="spring.application.name"/>

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://0.0.0.0:3100/loki/api/v1/push</url>
        </http>

        <labels>
            app=${SERVICE_NAME}
            host=${HOSTNAME}
        </labels>

        <message>
            <pattern>[%thread] [%X{traceId}] [%X{spanId}] [%logger{36}] %msg%n</pattern>
        </message>
    </appender>

    <root level="INFO">
        <appender-ref ref="LOKI"/>
    </root>
</configuration>